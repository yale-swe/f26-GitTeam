# Local Postgres (default; matches docker-compose.yml).
DATABASE_URL=postgresql+psycopg://devsync:devsync@localhost:5432/devsync
DISCORD_BOT_TOKEN=
# Application id from the Discord developer portal. Used only to build the
# invite URL that adds this same bot to a server.
DISCORD_CLIENT_ID=
DISCORD_CHANNEL_ID=
# How many recent messages a project sync stores. Discord pages at 100.
DISCORD_IMPORT_LIMIT=100

# GitHub App (Settings → Developer settings → GitHub Apps). See DANIEL.md §6.2.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Convert the downloaded .pem to one line:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' github-app.pem
GITHUB_APP_PRIVATE_KEY=
# Last segment of https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# First sync looks back this many days; later syncs re-read this many hours
# before the last success. Each list stops after this many 100-item pages.
GITHUB_BACKFILL_DAYS=90
GITHUB_SYNC_OVERLAP_HOURS=72
GITHUB_MAX_PAGES=10

# For Supabase, replace with the Session pooler URL (Settings → Database →
# Connection string → "URI" under "Session pooler"). Use the pooler for the
# app and for Alembic migrations. See docs/supabase.md.
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth (Settings → API). Tokens from the frontend are verified here.
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Only for legacy projects that sign JWTs with a shared HS256 secret; leave
# empty to verify with the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]
